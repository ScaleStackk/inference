global
    log stdout format raw local0
    maxconn 512

defaults
    log global
    mode http
    option httplog
    option dontlognull
    option redispatch
    retries 2
    timeout http-request 15s
    timeout connect 5s
    timeout queue 10m
    timeout client 10m
    timeout server 10m
    timeout tunnel 10m

frontend ollama_api
    bind :11434
    default_backend ollama_nodes

listen statistics
    bind :8404
    stats enable
    stats uri /stats
    stats refresh 5s

backend ollama_nodes
    balance leastconn
    option httpchk
    http-check send meth GET uri /api/tags ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
    http-reuse safe
    # Backend server lines are generated from INFERENCE_NODES at startup.
