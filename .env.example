# Images
DOCKER_PLATFORM=linux/amd64
INFERENCE_IMAGE=questacase-inference:qwen3-4b
LOAD_BALANCER_IMAGE=questacase-inference-lb:3.4.7

# Model baked into the inference image during build
OLLAMA_VERSION=0.40.15
OLLAMA_MODEL=qwen3:4b

# Inference node runtime. Enable the GPU override only on a host with an NVIDIA
# GPU, driver and NVIDIA Docker runtime. The CloudFormation stack sets this true.
INFERENCE_BIND_ADDRESS=0.0.0.0
INFERENCE_PORT=11434
INFERENCE_GPU_ENABLED=false
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h
INFERENCE_MEMORY_LIMIT=8g
INFERENCE_CPU_LIMIT=4.0

# Load balancer runtime on the Web API EC2 instance.
# Use the private IP of every inference EC2 instance. When instances belong to
# different AWS accounts/VPCs, establish VPC peering and routes first.
INFERENCE_NODES=10.0.2.10:11434,10.0.3.10:11434
INFERENCE_MAX_CONNECTIONS=1
LOAD_BALANCER_BIND_ADDRESS=127.0.0.1
LOAD_BALANCER_PORT=11435
DOCKER_NETWORK=questacase
LOAD_BALANCER_MEMORY_LIMIT=256m
LOAD_BALANCER_CPU_LIMIT=0.5
